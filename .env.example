# Optional: where the SQLite database file lives. Defaults to data/app.db
# (relative to the working directory) if not set — no configuration is
# required to run the app.
#
# DATABASE_PATH=data/app.db

# By default, the sign-in cookie is marked Secure whenever NODE_ENV=production,
# which means browsers only send it back over HTTPS (or http://localhost).
# If you run this on plain HTTP over a LAN/VPN with no HTTPS reverse proxy in
# front of it (e.g. the Windows .bat launchers), set this to false, or sign-in
# will appear to succeed but bounce straight back to the login screen for
# anyone accessing it by IP address instead of localhost. Set to true to
# force it on even outside NODE_ENV=production (e.g. testing behind HTTPS).
#
# SECURE_COOKIE=false

# Optional: send account-credentials emails when an admin creates or resets a
# user in Settings > Manage users. Sign-in itself needs none of this — it
# works with zero configuration. Without these set, account creation still
# works; the admin just has to share the password manually. These can also
# be set from Settings > Manage SMTP instead, which takes precedence.
#
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notifications@example.com
# SMTP_PASSWORD=change-me
# SMTP_FROM=notifications@example.com
# SMTP_SECURE=false
# SMTP_ALLOW_SELF_SIGNED=false
